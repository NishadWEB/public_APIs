<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>States</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <h1>List of States</h1>
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>State</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
           <% states.forEach((state, i) => { %> <!-- countries is an array  -->
            <tr>
              <td data-label="#"> <%= i + 1 %> </td>
              <td data-label="STATE"> <%= state%> </td>
              <td data-label="Action">
                <form action="/cities" method="GET">
                  <input type="hidden" name="state" value="<%= state %>" >
                  <button class="statePage">See Cities</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>
